PORT=3000
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
IA_SERVICE_URL=http://localhost:8000

# Opcional: usada apenas pelo script `npx tsx scripts/migrate.ts` para aplicar
# migrations programaticamente. Obter no Supabase Dashboard -> Project Settings
# -> Database -> Connection string -> URI (modo Transaction Pooler na porta 6543).
DATABASE_URL=postgresql://postgres.[project-id]:[senha]@aws-0-[region].pooler.supabase.com:6543/postgres
