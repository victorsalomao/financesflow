{
  "expo": {
    "name": "FinanceFlow",
    "slug": "financeflow",
    "description": "App de controle financeiro para casais — gastos compartilhados, divisão de contas e metas conjuntas com captura inteligente por linguagem natural.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09091A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.victorsalomao.financeflow"
    },
    "android": {
      "package": "com.victorsalomao.financeflow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09091A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
